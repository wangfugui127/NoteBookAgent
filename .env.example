APP_NAME=NotebookAgent
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
MYSQL_ROOT_PASSWORD=local-root-password
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=notebookagent
MYSQL_USER=notebookagent
MYSQL_PASSWORD=notebookagent

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=document_chunks_v3
MILVUS_DOCUMENT_COLLECTION=notebook_documents_v1
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=notebookagent-neo4j

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
MODEL_CONTEXT_WINDOW=1048576
MAX_OUTPUT_TOKENS=32768
CONTEXT_SAFETY_RATIO=0.95
CONTEXT_TRIM_THRESHOLD=0.6
CONTEXT_SUMMARY_THRESHOLD=0.75
CONTEXT_KEEP_RECENT_TURNS=6
CONTEXT_KEEP_RECENT_TOOL_RESULTS=4
HISTORY_RECENT_RUNS=8

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

OPENALEX_MAILTO=
UPLOAD_DIR=/data/uploads
MCP_SERVERS_CONFIG=/app/config/mcp_servers.yaml
MCP_EXPOSE_CONFIG=/app/config/mcp_expose.yaml
SKILLS_CONFIG=/app/config/skills.yaml
EVAL_GOLDEN_PATH=/app/config/eval_golden.json
SEMANTIC_SCHOLAR_API_KEY=
RUN_LIVE_PROVIDER_TESTS=0
